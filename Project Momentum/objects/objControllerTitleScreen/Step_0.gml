//rotate large rings
titleAccents[0][3]+=2;
titleAccents[1][3]+=3;
titleAccents[2][3]-=4;

//rotate medium rings
titleAccents[3][3]-=4;
titleAccents[4][3]+=5;
titleAccents[5][3]+=5;
titleAccents[6][3]+=2;
titleAccents[7][3]-=4;
titleAccents[8][3]+=5;

//rotate small rings
titleAccents[9][3]+=5;
titleAccents[10][3]+=7;
titleAccents[11][3]-=3;
